{
  "name": "dtvsteams-catalog-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve.mjs web-app 8000",
    "dev:tv": "node scripts/serve.mjs tv-web 8100",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "build:prod": "tsc --noEmit && node scripts/build.mjs",
    "preview": "node scripts/serve.mjs dist 5000",
    "preview:web": "node scripts/serve.mjs dist/web-app 8000",
    "preview:tv": "node scripts/serve.mjs dist/tv-web 8100",
    "start": "node scripts/serve.mjs web-app 8000",
    "start:tv": "node scripts/serve.mjs tv-web 8100",
    "test": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=dtvsteams",
    "deploy:web": "npm run build && wrangler pages deploy dist/web-app --project-name=dtvsteams-web",
    "deploy:tv": "npm run build && wrangler pages deploy dist/tv-web --project-name=dtvsteams-tv"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^2.1.9",
    "jsdom": "^24.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@videojs/html": "^10.4.0",
    "@videojs/react": "^10.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "video.js": "^10.4.0"
  }
}
